# Hydra Profile: MoE (default)
# Qwopus3.6-MoE-A3B-v1-APEX-I-Mini on RTX 5060 Ti (COMBINED-OT expert split)
# Peer: RTX 3060, P100 for P/D split fallback

HYDRA_HEAD_RTX_NODE_CONFIG=node-rtx.yaml
HYDRA_HEAD_RTX3060_NODE_CONFIG=node-rtx3060.yaml
HYDRA_COORD_CONFIG_FILE=/etc/hydra/config/workers.json
HYDRA_COORD_COMBINED_ENABLED=true
HYDRA_COORD_MULTI_ENGINE_POLICY=combined
HYDRA_COORD_MULTI_ENGINE_THRESHOLD=4096
