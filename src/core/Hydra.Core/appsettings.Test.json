{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=hydra_test;Username=hydra;Password=hydra"
  },
  "EngineStore": {
    "BaseDir": "/tmp/hydra-test-store",
    "L1ChunkCacheDir": "/tmp/hydra-test-l1",
    "FallbackBaseDir": "/mnt/llm-ram/hydra-test-store"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hydra": "Information"
    }
  },
  "Routing": {
    "AllowedInstanceIds": ["A", "B"]
  },
  "HydraTest": {
    "InstanceEnvVar": "HYDRA_INSTANCE",
    "InstanceIdEnvVar": "HYDRA_INSTANCE_ID",
    "InstanceEnvValue": "test",
    "Notes": "T2: two cores (core-A/core-B) share this file; differentiate via HYDRA_INSTANCE_ID=A|B. Prod is untouched when HYDRA_INSTANCE is unset."
  }
}
