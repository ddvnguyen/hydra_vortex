#!/bin/bash
#
# TaskResume Hook - Memorize & Evolve Edition
# 
# Executes when a task is resumed after being interrupted. Initializes memory context,
# checks for orphaned WIP items from the previous session, and loads project memories.
# 
# Input: { 
#   taskId, 
#   taskResume: { 
#     taskMetadata: { taskId: string, ulid: string },
#     previousState: { lastMessageTs: string, messageCount: string, conversationHistoryDeleted: string }
#   }, 
#   clineVersion, timestamp, ... 
# }
# Output: { cancel: boolean, contextModification?: string, errorMessage?: string }

# Read JSON input from stdin
INPUT=$(cat)

# Parse input using jq
if command -v jq &> /dev/null; then
  TASK_ID=$(echo "$INPUT" | jq -r '.taskResume.taskMetadata.taskId')
  MSG_COUNT=$(echo "$INPUT" | jq -r '.taskResume.previousState.messageCount')
  CONVO_DELETED=$(echo "$INPUT" | jq -r '.taskResume.previousState.conversationHistoryDeleted // "false"')
  TIMESTAMP=$(echo "$INPUT" | jq -r '.timestamp')
else
  TASK_ID="<taskId>"
  MSG_COUNT="0"
  CONVO_DELETED="false"
  TIMESTAMP=$(date +%s%3N)
fi

# ──────────────────────────────────────────────
# Memorize & Evolve Logic
# ──────────────────────────────────────────────

# Orphan auto-archive control — default to false (informational only)
# Set MEMO_ORPHAN_AUTO_ARCHIVE=true to enable automatic archiving of orphaned WIP items
MEMO_ORPHAN_AUTO_ARCHIVE="${MEMO_ORPHAN_AUTO_ARCHIVE:-false}"

# Step 1: Check for orphaned WIP items (taskId not matching current TaskId)
WIP_CHECK_SIGNAL="CHECK_ORPHANED_WIP"

# Step 2: Load relevant project memories for this task
MEMORY_INJECTION_SIGNAL="LOAD_PROJECT_MEMORY_CONTEXT"

# ──────────────────────────────────────────────
# Dynamic Utility Script Resolution
# Uses utils-finder.sh to locate scripts in multiple possible locations
# ──────────────────────────────────────────────

# Source the dynamic utils finder library
FINDER_SH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../lib/utils-finder.sh"
if [ -f "$FINDER_SH" ]; then
  source "$FINDER_SH"
else
  # Fallback: try relative path from hooks/lib/
  FINDER_SH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/utils-finder.sh"
  if [ -f "$FINDER_SH" ]; then
    source "$FINDER_SH"
  fi
fi

# Dynamic resolution of utility script paths using utils-finder.sh
NEO4J_QUERY_SH=$(find_utils "neo4j-wip-query.sh") || NEO4J_QUERY_SH=""
PROJECT_ID_SH=$(find_utils "project-id.sh") || PROJECT_ID_SH=""

PROJECT_ID=""
if [ -n "$PROJECT_ID_SH" ] && [ -f "$PROJECT_ID_SH" ]; then
  PROJECT_ID=$(bash "$PROJECT_ID_SH" --project-id 2>/dev/null) || PROJECT_ID="unknown"
fi
PROJECT_ID="${PROJECT_ID:-unknown}"

# Debug: log resolved paths
if [ -n "${MEMO_DEBUG:-}" ]; then
  echo "[TaskResume] Resolved paths:" >&2
  echo "[TaskResume]   NEO4J_QUERY_SH=$NEO4J_QUERY_SH" >&2
  echo "[TaskResume]   PROJECT_ID_SH=$PROJECT_ID_SH" >&2
fi

# Fetch orphaned WIP items from Neo4j (informational — doesn't delete)
ORPHAN_INFO=""
if [ -f "$NEO4J_QUERY_SH" ]; then
  ORPHAN_RESULT=$(bash "$NEO4J_QUERY_SH" list-orphans --task-id "$TASK_ID" 2>/dev/null) || ORPHAN_RESULT="[]"
  
  # Extract orphan names from result (avoids complex jq parsing — use simple text extraction)
  if [ -n "$ORPHAN_RESULT" ] && [ "$ORPHAN_RESULT" != "null" ]; then
    ORPHAN_COUNT=$(echo "$ORPHAN_RESULT" | python3 -c "import sys,json; data=json.load(sys.stdin); print(len(data))" 2>/dev/null) || ORPHAN_COUNT="0"
    
    if [ "$ORPHAN_COUNT" -gt 0 ] 2>/dev/null; then
      # Extract orphan entity names using python3 for reliable JSON parsing
      ORPHAN_NAMES=$(echo "$ORPHAN_RESULT" | python3 -c "import sys,json; data=json.load(sys.stdin); print('\n- '.join([r.get('name','unknown') for r in data]))" 2>/dev/null) || ORPHAN_NAMES="Unknown"
      
      if [ "$MEMO_ORPHAN_AUTO_ARCHIVE" = "true" ]; then
        ORPHAN_INFO="[Memorize&Evol] Orphaned WIP items found (${ORPHAN_COUNT}):

$ORPHAN_NAMES

⚠ AUTO-ARCHIVE ENABLED: These orphaned WIP items will be archived with status=abandoned.
Action: review above orphans — if any are still needed, cancel archive by setting MEMO_ORPHAN_AUTO_ARCHIVE=false"
      else
        ORPHAN_INFO="[Memorize&Evol] Orphaned WIP items found (${ORPHAN_COUNT}) — INFO ONLY (MEMO_ORPHAN_AUTO_ARCHIVE=false):

$ORPHAN_NAMES

ℹ These orphaned WIP items are kept for reference. Auto-archive is disabled.
To enable automatic archiving, set MEMO_ORPHAN_AUTO_ARCHIVE=true"
      fi
    fi
  fi
fi

# Convert millisecond timestamp to ISO using awk (avoids bash integer overflow)
TIMESTAMP_ISO=""
if command -v python3 &> /dev/null; then
  TIMESTAMP_ISO=$(python3 -c "from datetime import datetime,timezone; print(datetime.fromtimestamp($TIMESTAMP/1000,tz=timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'))" 2>/dev/null) || TIMESTAMP_ISO=""
elif command -v date &> /dev/null; then
  if [ ${#TIMESTAMP} -le 10 ]; then
    TIMESTAMP_ISO=$(date -u -d @"$TIMESTAMP" +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null) || TIMESTAMP_ISO=""
  fi
fi
TIMESTAMP_ISO="${TIMESTAMP_ISO:-unknown}"

# ──────────────────────────────────────────────
# Build context modification string using raw multi-line text
# ──────────────────────────────────────────────

if [ -n "$ORPHAN_INFO" ]; then
  CONTEXT_MOD="Task resumed at ${TIMESTAMP_ISO} (TaskId: ${TASK_ID}, previous messages: $MSG_COUNT, conversation deleted: $CONVO_DELETED)

[Memorize&Evol] Memory Initialization on Task Resume:
- Check orphaned WIP items from interrupted session — ORPHAN CHECK COMPLETED
${ORPHAN_INFO}
- Load project memory context: LOAD_PROJECT_MEMORY_CONTEXT"
else
  CONTEXT_MOD="Task resumed at ${TIMESTAMP_ISO} (TaskId: ${TASK_ID}, previous messages: $MSG_COUNT, conversation deleted: $CONVO_DELETED)

[Memorize&Evol] Memory Initialization on Task Resume:
- No orphaned WIP items found from interrupted session
- Check orphaned WIP items: NONE
- Load project memory context: LOAD_PROJECT_MEMORY_CONTEXT"
fi

echo "[TaskResume] Resuming task: $TASK_ID (previous messages: $MSG_COUNT, auto-archive=$MEMO_ORPHAN_AUTO_ARCHIVE, orphans=$ORPHAN_COUNT)" >&2

# Return result as JSON — jq handles all escaping (newlines, quotes, backslashes) automatically via --arg ctx
if command -v jq &> /dev/null; then
  jq -n --arg ctx "$CONTEXT_MOD" \
    '{"cancel":false,"contextModification":$ctx,"errorMessage":""}'
else
  # Fallback: manual JSON escaping for jq-unavailable environments
  ESCAPED_MOD=$(printf '%s' "$CONTEXT_MOD" | sed 's/\\/\\\\/g; s/"/\\"/g')
  echo "{\"cancel\":false,\"contextModification\":\"${ESCAPED_MOD}\",\"errorMessage\":\"\"}"
fi