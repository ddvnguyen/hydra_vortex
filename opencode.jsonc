{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "CLAUDE.md"
  ],
  "provider": {
    "hydra": {
      "name": "Hydra Coordinator (local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:9000/v1",
        "apiKey": "hydra-local"
      },
      "models": {
        "dense-27b-combined": {
          "name": "Qwen 3.6 27B Dense (COMBINED RTX 5060 Ti + 3060)",
          "limit": {
            "context": 128000,
            "output": 32000
          }
        },
        "moe-35b-solo": {
          "name": "Qwen 3.6 35B-A3B MoE (SOLO RTX 5060 Ti)",
          "limit": {
            "context": 128000,
            "output": 32000
          }
        },
        "moe-35b-pd": {
          "name": "Qwen 3.6 35B-A3B MoE (P/D Split: RTX prefill + P100 decode)",
          "limit": {
            "context": 128000,
            "output": 32000
          }
        },
        "hydra-auto": {
          "name": "Hydra Auto (picks best model per prompt)",
          "limit": {
            "context": 128000,
            "output": 32000
          }
        }
      }
    }
  }
}