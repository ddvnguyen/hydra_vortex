# Hydra Profile: Dense
# Qwopus3.6-Dense-Coder-Compat-MTP-Q5_K_M on RTX 5060 Ti + RTX 3060 (COMBINED-static layer split)
# Peer: RTX 3060 (0 slots, dedicated ggml-RPC backend)
# P100: untouched, handles 35B SOLO sessions (cross-model guard prevents KV restore)

HYDRA_HEAD_RTX_NODE_CONFIG=node-rtx.yaml
HYDRA_HEAD_RTX3060_NODE_CONFIG=node-rtx3060.yaml
HYDRA_COORD_CONFIG_FILE=/etc/hydra/config/workers.json
HYDRA_COORD_COMBINED_ENABLED=true
HYDRA_COORD_MULTI_ENGINE_POLICY=combined
HYDRA_COORD_MULTI_ENGINE_THRESHOLD=0
HYDRA_COORD_NO_STORE_KV_RESTORE=false
# Cross-model KV reuse: 27B↔35B restore corrupts decode. Disabled for dense profile.
HYDRA_COORD_ALLOW_CROSS_MODEL_KV_REUSE=false
# Only route to the 27B Dense model — reject any P100 (35B MoE) routing.
# Value is the engine's GGUF-file alias (per-node preset vocabulary), not the
# raw .gguf filename — #479/S3 moved residency to the engine's own report
# (preset_aliases / model_alias), so the guard matches aliases.
HYDRA_COORD_ALLOWED_MODELS=qwen3.6-27B-coder
