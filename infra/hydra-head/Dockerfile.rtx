# Hydra Head - RTX Container
# Runs llama-server with Hydra Head process management (OCI registry)
# CUDA 13.2 runtime inlined — no external base image dependency
# Also bundles the 3 monitoring sidecars (node_exporter, nvidia_gpu_exporter,
# promtail) so hydra-head manages ALL services on this node.

FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive

# Install bootstrap dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    unzip \
    wget \
    gnupg \
    && rm -rf /var/lib/apt/lists/*

# Add NVIDIA's CUDA repository keyring (owner: use 24.04 keyring + CUDA 13.2.2
# packages — the 26.04 repo only ships 13.3, so the 24.04 repo path is used)
RUN curl -fSsL https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64/cuda-keyring_1.1-1_all.deb -o cuda-keyring.deb \
    && dpkg -i cuda-keyring.deb \
    && rm cuda-keyring.deb

# Install pinned CUDA 13.2.2 runtime components
# (owner: exact version 13.2.2 — the -13-2 series metapackages float to the
# newest 13.2.x; pin the runtime release + hold its component micro-versions
# via apt preferences so transitive deps cannot float past 13.2.2)
COPY infra/hydra-head/init/cuda-pin.conf /etc/apt/preferences.d/cuda-13-2-2
RUN apt-get update && apt-get install -y --no-install-recommends \
    cuda-runtime-13-2=13.2.2-1 \
    cublas13=13.2.2-1 \
    libcublas13-cuda-13=13.2.2.2-1 \
    libnccl2 \
    libgomp1 \
    libibverbs1 \
    && rm -rf /var/lib/apt/lists/*

# NVIDIA Container Toolkit environment
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

# CUDA runtime paths — CUDA 13.2.2 (pinned via cuda-runtime-13-2=13.2.2-1).
# The packages install into /usr/local/cuda-13.2 (aliased by the
# /usr/local/cuda-13 alternatives symlink, both resolve to the same dir);
# keep both on the search path so every runtime component resolves.
ENV PATH=/usr/local/cuda-13.2/bin:/usr/local/cuda-13/bin:${PATH}
ENV LD_LIBRARY_PATH=/usr/local/cuda-13.2/lib64:/usr/local/cuda-13/lib64:${LD_LIBRARY_PATH}

# Copy init verification script
COPY infra/hydra-head/init/verify_and_start.sh /init/verify_and_start.sh
RUN chmod +x /init/verify_and_start.sh

# Copy hydra-head binary
COPY bin/hydra-head /usr/local/bin/hydra-head

# Config files are NOT baked into the image — they are mounted at runtime
# from the host (see docker-compose.hydra.yml: ./hydra-head/config:/opt/hydra/config:ro).
# This keeps the image build-time immutable and lets node configs (engine
# pins, model presets) change without an image rebuild.

# Download the 2 monitoring sidecar binaries (baked into the image so
# hydra-head can spawn them as child processes inside this container).
# promtail was removed in #363 — per-child labeled writers push
# llama / node_exporter / nvidia_exporter logs to the OTel Collector
# directly.
RUN mkdir -p /opt/hydra/bin && cd /tmp && \
    curl -sLO https://github.com/prometheus/node_exporter/releases/download/v1.8.2/node_exporter-1.8.2.linux-amd64.tar.gz && \
    tar xf node_exporter-1.8.2.linux-amd64.tar.gz && \
    mv node_exporter-1.8.2.linux-amd64/node_exporter /opt/hydra/bin/node_exporter && \
    rm -rf node_exporter-1.8.2* && \
    curl -sLO https://github.com/utkuozdemir/nvidia_gpu_exporter/releases/download/v1.2.1/nvidia_gpu_exporter_1.2.1_linux_x86_64.tar.gz && \
    tar xf nvidia_gpu_exporter_1.2.1_linux_x86_64.tar.gz && \
    mv nvidia_gpu_exporter /opt/hydra/bin/nvidia_gpu_exporter && \
    rm -rf nvidia_gpu_exporter_1.2.1* LICENSE README.md && \
    chmod +x /opt/hydra/bin/node_exporter /opt/hydra/bin/nvidia_gpu_exporter

# Create directories for binaries, llama-server, and logs.
# (promtail-positions volume mount removed in #363.)
#
# Owned by the base image's built-in `ubuntu` user (UID/GID 1000) rather
# than a separately created account — docker-compose.hydra.yml runs this
# container as `user: "1000:1000"`, and a distinct `hydra` user created via
# `useradd` with no `-u` lands on the next free UID (1001, since ubuntu:26.04
# already ships `ubuntu` at 1000), leaving these dirs unwritable by the
# actual runtime UID (#permission-denied extracting OCI-pulled binaries).
RUN mkdir -p /opt/hydra/bin /opt/hydra/tmp /var/log/hydra /llama/bin && \
    chown -R ubuntu:ubuntu /opt/hydra /var/log/hydra /llama

USER ubuntu
WORKDIR /opt/hydra

# Expose Hydra Head API + llama-server + sidecar exporter ports
# (promtail :9080 removed in #363.)
EXPOSE 9700 8080 9503 9100 9835

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:9700/health || exit 1

# Run through verification script, then hydra-head
ENTRYPOINT ["/init/verify_and_start.sh"]
CMD ["-global", "/opt/hydra/config/global.yaml", "-node", "/opt/hydra/config/node-rtx.yaml", "-api-port", "9700"]
