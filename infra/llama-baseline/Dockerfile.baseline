# Baseline 2xRTX vanilla llama.cpp — bare bone, no Hydra
# Single llama-server pooling both GPUs (5060 Ti 16GB + 3060 12GB)
# Upstream ggml-org/llama.cpp built on host with CUDA 13.2.2, copied in.
# CUDA 13.2.2 runtime — mirrors infra/llama-rtx-node/Dockerfile_26.04_cuda13.2

FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl gnupg libcurl4 libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fSsL https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64/cuda-keyring_1.1-1_all.deb -o cuda-keyring.deb \
    && dpkg -i cuda-keyring.deb && rm cuda-keyring.deb

RUN apt-get update && apt-get install -y --no-install-recommends \
    cuda-cudart-13-2 libcublas-13-2 libnccl2 libibverbs1 \
    && rm -rf /var/lib/apt/lists/*

ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility
ENV PATH=/usr/local/cuda-13.2/bin:${PATH}
ENV LD_LIBRARY_PATH=/usr/local/cuda-13.2/targets/x86_64-linux/lib:/usr/local/lib:${LD_LIBRARY_PATH}

# Host-built upstream binary (cmake --build --parallel 8) + shared libs
# .dockerignore whitelists these paths (src/llama-cpp/build/bin/*)
COPY src/llama-cpp/build/bin/llama-server /usr/local/bin/llama-server
COPY src/llama-cpp/build/bin/*.so* /usr/local/lib/
RUN chmod +x /usr/local/bin/llama-server && ldconfig

# Minimal runtime wrapper: try 96K first, fallback 64K on CUDA OOM (handled by compose command)
WORKDIR /models
EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
  CMD curl -f http://localhost:8080/health || exit 1

ENTRYPOINT ["/usr/local/bin/llama-server"]
# Default args overridden by compose — kept here for `podman run` without compose:
CMD ["--help"]
