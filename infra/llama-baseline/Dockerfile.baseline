# Baseline 2xRTX vanilla llama.cpp — bare bone, no Hydra
# RPC-split: ggml-rpc-server (3060, CUDA1) + llama-server (5060 Ti, CUDA0)
# Upstream ggml-org/llama.cpp built on host with CUDA 13.2.2, copied in.
# CUDA 13.2.2 runtime — mirrors infra/llama-rtx-node/Dockerfile_26.04_cuda13.2
#
# ENTRYPOINT: llama-cpp-entrypoint.sh — reads a YAML params file (set via
#   LLAMACPP_PARAMS_FILE env var) and exec's llama-server with the constructed
#   args. Mirrors the logic of infra/llama-baseline/run-with-params.sh so the
#   bench-test workflow and the production container workflow share the same
#   params-file schema.
#
# DEFAULT PIN (set in docker-compose.baseline.yml):
#   **Arm 083** (human-approved 2026-08-28) — UD-Q5_K_M @163,840 ctx
#     (yarn scale 5), split 27/38, q8_0/q4_1 KV, ubatch 512, draft-mtp f16.
#     Decode 37.47 t/s, acc 0.6095, CUDA0 min-free 67 MiB (single-request
#     bench) / 43 MiB (pi-harness multi-turn). Pi-harness validated
#     9/10 turns OK, 0 Xid, 9/9 KV-cache growth. Params file:
#     infra/llama-baseline/params/083-udq5-163840-k-q8_0-v-q4_1-ubatch-512.yml
#
# ROLLBACK (fallback pin):
#   **Arm 079** — UD-Q5_K_M @155,648 ctx, q8_0/q4_1, ubatch 512, draft-mtp f16.
#     Decode 37.57 t/s, acc 0.63, CUDA0 min-free 704 MiB. Params file:
#     infra/llama-baseline/params/079-udq5-155648-v-q4_1-ubatch-512.yml
#   To rollback: change the LLAMACPP_PARAMS_FILE env var in compose (or
#   override at podman-compose up time) to point at 079-*.yml, then restart.
#   No compose-file change required.

FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl gnupg libcurl4 libgomp1 python3 python3-yaml \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fSsL https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64/cuda-keyring_1.1-1_all.deb -o cuda-keyring.deb \
    && dpkg -i cuda-keyring.deb && rm cuda-keyring.deb

RUN apt-get update && apt-get install -y --no-install-recommends \
    cuda-cudart-13-2 libcublas-13-2 libnccl2 libibverbs1 \
    && rm -rf /var/lib/apt/lists/*

ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility
ENV PATH=/usr/local/cuda-13.2/bin:${PATH}
ENV LD_LIBRARY_PATH=/usr/local/cuda-13.2/targets/x86_64-linux/lib:/usr/local/lib:${LD_LIBRARY_PATH}

# Host-built upstream binary (cmake --build --parallel 8) + shared libs.
# Built in src/llama-cpp/build-cuda1322/ with explicit, matching
# -DCUDAToolkit_ROOT=/opt/software/cuda/13.2.2 -DCMAKE_CUDA_COMPILER=.../13.2.2/bin/nvcc
# (never mix compiler/toolkit-root versions — see docs/investigations/703-3060-xid-crash.md)
# .dockerignore whitelists these paths (src/llama-cpp/build-cuda1322/bin/*)
COPY src/llama-cpp/build-cuda1322/bin/llama-server /usr/local/bin/llama-server
COPY src/llama-cpp/build-cuda1322/bin/ggml-rpc-server /usr/local/bin/ggml-rpc-server
COPY src/llama-cpp/build-cuda1322/bin/*.so* /usr/local/lib/
RUN chmod +x /usr/local/bin/llama-server /usr/local/bin/ggml-rpc-server && ldconfig

# Parametrized entrypoint: reads LLAMACPP_PARAMS_FILE (YAML), exec's llama-server.
# Mirrors the logic of infra/llama-baseline/run-with-params.sh so the bench-
# test workflow and the production container workflow share the same params-
# file schema.
COPY infra/llama-baseline/llama-cpp-entrypoint.sh /usr/local/bin/llama-cpp-entrypoint.sh
RUN chmod +x /usr/local/bin/llama-cpp-entrypoint.sh

WORKDIR /models
EXPOSE 18081

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
  CMD curl -f http://localhost:18081/health || exit 1

ENTRYPOINT ["/usr/local/bin/llama-cpp-entrypoint.sh"]
# Default args overridden by compose via LLAMACPP_PARAMS_FILE — kept here for
# `podman run` without compose: requires LLAMACPP_PARAMS_FILE to be set.
CMD []
