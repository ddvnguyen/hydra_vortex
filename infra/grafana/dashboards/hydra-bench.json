{
  "title": "Hydra — Bench",
  "uid": "hydra-bench",
  "version": 1,
  "timezone": "browser",
  "editable": true,
  "tags": ["hydra", "bench", "debug", "p-d"],
  "schemaVersion": 39,
  "description": "P/D Performance bench (Issue #306). Debug view for prefill/decode pipeline metrics.",
  "links": [
    {
      "title": "Overview",
      "url": "/d/hydra-overview",
      "type": "link",
      "icon": "external link",
      "targetBlank": false
    },
    {
      "title": "Inference",
      "url": "/d/hydra-inference",
      "type": "link",
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "P/D Performance (Issue #306 bench)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "P/D request rate (req/s, by node x phase)",
      "description": "Issue #306: aggregate prefill + decode request rates over time. Backed by hydra_prefill_seconds and hydra_decode_seconds histograms.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum by (node) (rate(hydra_prefill_seconds_count[1m]))",
          "legendFormat": "prefill {{node}}"
        },
        {
          "expr": "sum by (node) (rate(hydra_decode_seconds_count[1m]))",
          "legendFormat": "decode {{node}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" }
      }
    },
    {
      "type": "timeseries",
      "title": "Warm-slot hit rate",
      "description": "Issue #306: share of requests served from a warm slot vs cold prefill. The S1 success criterion is >=0.95 P50 over a multi-turn session.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(hydra_warm_session_starts[5m])) / clamp_min(sum(rate(hydra_warm_session_starts[5m])) + sum(rate(hydra_cold_session_starts[5m])), 0.001)",
          "legendFormat": "warm hit rate"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" }
      }
    },
    {
      "type": "timeseries",
      "title": "Phase latency p99 (s)",
      "description": "Issue #306: per-phase p99 latency for prefill + decode. Use this to spot regressions early.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, session_type) (rate(hydra_prefill_seconds_bucket[5m])))",
          "legendFormat": "prefill p99 {{session_type}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, session_type) (rate(hydra_decode_seconds_bucket[5m])))",
          "legendFormat": "decode p99 {{session_type}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" }
      }
    },
    {
      "type": "timeseries",
      "title": "Queue depth (active requests at each stage)",
      "description": "Issue #306 + E4 (#269): the number of requests currently sitting in each pipeline stage.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "hydra_main_queue_depth",
          "legendFormat": "main (classifier)"
        },
        {
          "expr": "hydra_prefill_queue_depth",
          "legendFormat": "prefill"
        },
        {
          "expr": "hydra_decode_queue_depth",
          "legendFormat": "decode"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" }
      }
    }
  ],
  "templating": {
    "list": []
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "refresh": "30s"
}
