{
  "title": "Hydra — Overview",
  "uid": "hydra-overview",
  "version": 1,
  "timezone": "browser",
  "editable": true,
  "tags": ["hydra", "overview"],
  "schemaVersion": 39,
  "description": "At-a-glance operational view: service health, metrics, GPU/host gauges. Parameterized by $node.",
  "links": [
    {
      "title": "Inference",
      "url": "/d/hydra-inference",
      "type": "link",
      "icon": "external link",
      "targetBlank": false
    },
    {
      "title": "Bench",
      "url": "/d/hydra-bench",
      "type": "link",
      "icon": "external link",
      "targetBlank": false
    },
    {
      "title": "Coordinator",
      "url": "/d/hydra-coordinator",
      "type": "link",
      "icon": "external link",
      "targetBlank": false
    },
    {
      "title": "Logs",
      "url": "/d/hydra-logs",
      "type": "link",
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Service Health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "table",
      "title": "Target Status",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "up",
          "legendFormat": "{{component}} {{node}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Value", "desc": false }]
      },
      "fieldConfig": {
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-text", "mode": "basic" } },
              {
                "id": "thresholds",
                "value": {
                  "steps": [
                    { "color": "red", "value": null },
                    { "color": "green", "value": 1 }
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "stat",
      "title": "llama-server Health",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "up{component=\"llama-server\"}",
          "legendFormat": "{{node}}"
        }
      ],
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "options": {
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red" },
                "1": { "text": "UP", "color": "green" }
              }
            }
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Agent Slots Idle",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "hydra_agent_slots_idle",
          "legendFormat": "{{node}}"
        }
      ],
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "options": {
        "colorMode": "background",
        "graphMode": "sparkline"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0 },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "type": "row",
      "title": "Service Metrics",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
    },
    {
      "type": "stat",
      "title": "Request Rate",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "rate(hydra_requests_total[1m])",
          "legendFormat": "{{node}}"
        }
      ],
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 6 },
      "options": { "colorMode": "background", "graphMode": "sparkline" }
    },
    {
      "type": "stat",
      "title": "Active Sessions",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(hydra_active_sessions)",
          "legendFormat": "sessions"
        }
      ],
      "gridPos": { "h": 6, "w": 4, "x": 4, "y": 6 },
      "options": { "colorMode": "background", "graphMode": "sparkline" }
    },
    {
      "type": "stat",
      "title": "Store Ops/s",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "rate(hydra_store_ops_total[1m])",
          "legendFormat": "{{op}}"
        }
      ],
      "gridPos": { "h": 6, "w": 4, "x": 8, "y": 6 },
      "options": { "colorMode": "background", "graphMode": "sparkline" }
    },
    {
      "type": "stat",
      "title": "Store Bytes/s",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "rate(hydra_store_bytes_stored[1m]) + rate(hydra_store_bytes_sent[1m])",
          "legendFormat": "bytes/s"
        }
      ],
      "unit": "bytes",
      "gridPos": { "h": 6, "w": 4, "x": 12, "y": 6 },
      "options": { "colorMode": "background", "graphMode": "sparkline" }
    },
    {
      "type": "stat",
      "title": "Cache Hit Rate",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "rate(hydra_cache_hits_total[1m]) / (rate(hydra_requests_total[1m]) + 0.001) * 100",
          "legendFormat": "hit %"
        }
      ],
      "unit": "percent",
      "gridPos": { "h": 6, "w": 4, "x": 16, "y": 6 },
      "options": { "colorMode": "background", "graphMode": "sparkline" }
    },
    {
      "type": "stat",
      "title": "Migration Rate",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "rate(hydra_migrations_total[1m])",
          "legendFormat": "{{from}}\u2192{{to}}"
        }
      ],
      "gridPos": { "h": 6, "w": 4, "x": 20, "y": 6 },
      "options": { "colorMode": "background", "graphMode": "sparkline" }
    },
    {
      "type": "row",
      "title": "Host & GPU",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 12 }
    },
    {
      "type": "gauge",
      "title": "GPU Utilization",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "max by(gpu, modelName, node) (DCGM_FI_DEV_GPU_UTIL{job=~\"hydra-gpu.*\"})\nor max by(modelName, node) (label_replace(nvidia_smi_utilization_gpu_ratio{job=~\"hydra-gpu.*\"} * 100, \"modelName\", \"$1\", \"name\", \"(.+)\"))",
          "legendFormat": "{{modelName}} GPU{{gpu}} ({{node}})"
        }
      ],
      "unit": "percent",
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 13 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "thresholds": [
          { "color": "green", "value": null },
          { "color": "orange", "value": 70 },
          { "color": "red", "value": 90 }
        ]
      }
    },
    {
      "type": "gauge",
      "title": "GPU Memory",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "(max by(gpu, modelName, node) (DCGM_FI_DEV_FB_USED{job=~\"hydra-gpu.*\"}) / (max by(gpu, modelName, node) (DCGM_FI_DEV_FB_USED{job=~\"hydra-gpu.*\"}) + max by(gpu, modelName, node) (DCGM_FI_DEV_FB_FREE{job=~\"hydra-gpu.*\"})) * 100)\nor max by(modelName, node) (label_replace(nvidia_smi_memory_used_bytes{job=~\"hydra-gpu.*\"} / nvidia_smi_memory_total_bytes{job=~\"hydra-gpu.*\"} * 100, \"modelName\", \"$1\", \"name\", \"(.+)\"))",
          "legendFormat": "{{modelName}} GPU{{gpu}} ({{node}})"
        }
      ],
      "unit": "percent",
      "gridPos": { "h": 6, "w": 4, "x": 4, "y": 13 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "thresholds": [
          { "color": "green", "value": null },
          { "color": "orange", "value": 80 },
          { "color": "red", "value": 95 }
        ]
      }
    },
    {
      "type": "stat",
      "title": "GPU Temperature",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "max by(gpu, modelName, node) (DCGM_FI_DEV_GPU_TEMP{job=~\"hydra-gpu.*\"})\nor max by(modelName, node) (label_replace(nvidia_smi_temperature_gpu{job=~\"hydra-gpu.*\"}, \"modelName\", \"$1\", \"name\", \"(.+)\"))",
          "legendFormat": "{{modelName}} GPU{{gpu}} ({{node}})"
        }
      ],
      "unit": "celsius",
      "gridPos": { "h": 6, "w": 4, "x": 8, "y": 13 },
      "options": { "colorMode": "background", "graphMode": "sparkline" }
    },
    {
      "type": "stat",
      "title": "GPU Power",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "max by(gpu, modelName, node) (DCGM_FI_DEV_POWER_USAGE{job=~\"hydra-gpu.*\"})\nor max by(modelName, node) (label_replace(nvidia_smi_power_draw_watts{job=~\"hydra-gpu.*\"}, \"modelName\", \"$1\", \"name\", \"(.+)\"))",
          "legendFormat": "{{modelName}} GPU{{gpu}} ({{node}})"
        }
      ],
      "unit": "watt",
      "gridPos": { "h": 6, "w": 4, "x": 12, "y": 13 },
      "options": { "colorMode": "background", "graphMode": "sparkline" }
    },
    {
      "type": "stat",
      "title": "CPU Utilization",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "100 - (avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)",
          "legendFormat": "cpu"
        }
      ],
      "unit": "percent",
      "gridPos": { "h": 6, "w": 4, "x": 16, "y": 13 },
      "options": { "colorMode": "background", "graphMode": "sparkline" }
    },
    {
      "type": "stat",
      "title": "Memory Utilization",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100",
          "legendFormat": "memory"
        }
      ],
      "unit": "percent",
      "gridPos": { "h": 6, "w": 4, "x": 20, "y": 13 },
      "options": { "colorMode": "background", "graphMode": "sparkline" }
    }
  ],
  "templating": {
    "list": []
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "refresh": "30s"
}
